{
  "name": "bol-language-player",
  "version": "0.5.2",
  "description": "Learn everyday language from the music playing in Spotify.",
  "main": "main.js",
  "type": "commonjs",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "test": "node --test",
    "build": "electron-builder --mac dir",
    "dist": "electron-builder --mac dmg"
  },
  "devDependencies": {
    "electron": "^39.2.1",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.hima.bol",
    "productName": "Bol",
    "electronLanguages": ["en"],
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "renderer/**/*",
      "package.json"
    ],
    "mac": {
      "icon": "assets/icon.icns",
      "category": "public.app-category.education",
      "target": ["dir"],
      "hardenedRuntime": false,
      "extendInfo": {
        "CFBundleName": "Bol",
        "CFBundleDisplayName": "Bol - musical language learning",
        "NSAppleEventsUsageDescription": "Bol reads the current song and playback position from Spotify to synchronize lyrics.",
        "NSMicrophoneUsageDescription": "Bol may use audio recognition as an optional fallback when playback metadata is unavailable."
      }
    }
  }
}
